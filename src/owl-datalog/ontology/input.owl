<?xml version="1.0"?>

<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:ex="http://example.org/university#">

    <owl:Ontology rdf:about="http://example.org/university"/>

    <!-- Classes -->

    <owl:Class rdf:about="http://example.org/university#Person"/>

    <owl:Class rdf:about="http://example.org/university#Student">
        <rdfs:subClassOf rdf:resource="http://example.org/university#Person"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university#Professor">
        <rdfs:subClassOf rdf:resource="http://example.org/university#Person"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/university#Course"/>

    <!-- Properties -->

    <owl:ObjectProperty rdf:about="http://example.org/university#memberOf">
        <rdfs:domain rdf:resource="http://example.org/university#Person"/>
        <rdfs:range rdf:resource="http://example.org/university#Course"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/university#teaches">
        <rdfs:subPropertyOf rdf:resource="http://example.org/university#memberOf"/>
        <rdfs:domain rdf:resource="http://example.org/university#Professor"/>
        <rdfs:range rdf:resource="http://example.org/university#Course"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/university#enrolledIn">
        <rdfs:subPropertyOf rdf:resource="http://example.org/university#memberOf"/>
        <rdfs:domain rdf:resource="http://example.org/university#Student"/>
        <rdfs:range rdf:resource="http://example.org/university#Course"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/university#hasStudent">
        <owl:inverseOf rdf:resource="http://example.org/university#enrolledIn"/>
    </owl:ObjectProperty>

    <!-- Individuals -->

    <owl:NamedIndividual rdf:about="http://example.org/university#alice">
        <rdf:type rdf:resource="http://example.org/university#Student"/>
        <ex:enrolledIn rdf:resource="http://example.org/university#logic101"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/university#bob">
        <rdf:type rdf:resource="http://example.org/university#Professor"/>
        <ex:teaches rdf:resource="http://example.org/university#logic101"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/university#logic101">
        <rdf:type rdf:resource="http://example.org/university#Course"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/university#charlie">
        <ex:enrolledIn rdf:resource="http://example.org/university#logic101"/>
    </owl:NamedIndividual>

</rdf:RDF>